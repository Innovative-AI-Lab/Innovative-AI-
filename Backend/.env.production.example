# Backend Production Environment Variables Example
NODE_ENV=production
PORT=4001

# Add your production frontend URL (e.g., https://innovative-ai.vercel.app)
FRONTEND_URL=https://your-frontend-url.vercel.app

# Add your production MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/innovative-ai?retryWrites=true&w=majority

# Generate a strong, secure, long random string for this
JWT_SECRET=your_super_secret_production_jwt_key_here

# Add your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
